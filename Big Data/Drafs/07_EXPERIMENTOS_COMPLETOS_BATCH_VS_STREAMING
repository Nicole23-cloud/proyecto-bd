def limpiar(df):
    """Limpieza del experimento 1 y 3: sin nulos y sin valores negativos."""
    return df.na.drop().filter("order_item_id > 0 AND price >= 0 AND freight_value >= 0")

def ident(df):
    """Sin limpieza (experimentos 2, 5 y 6)."""
    return df

def A_completo(carpeta, tabla, lim=limpiar):
    """A: lee TODO lo acumulado y rehace la tabla."""
    t = time.time()
    lim(spark.read.parquet(f"{carpeta}/llegada_*")).write.mode("overwrite").saveAsTable(tabla)
    return time.time() - t

def B_streaming(carpeta, ckpt, tabla, esquema, lim=limpiar):
    """B: streaming con checkpoint. Procesa lo pendiente y se detiene."""
    t = time.time()
    q = (lim(spark.readStream.format("cloudFiles")
             .option("cloudFiles.format", "parquet")
             .schema(esquema).load(carpeta))
         .writeStream.format("delta")
         .option("checkpointLocation", ckpt)
         .trigger(availableNow=True)
         .toTable(tabla))
    q.awaitTermination()
    return time.time() - t

def C_incremental(ruta_llegada, tabla, lim=limpiar):
    """C: lee SOLO la llegada nueva y la agrega."""
    t = time.time()
    lim(spark.read.parquet(ruta_llegada)).write.mode("append").saveAsTable(tabla)
    return time.time() - t

def resumen_tabla(tabla):
    d = spark.table(tabla)
    return d.count(), float(d.agg(F.sum("price")).first()[0] or 0)

def verificar_iguales(dic, tol=0.5):
    """Comprueba que todas las formas dejaron el mismo resultado (mismas filas y suma de precios)."""
    ref = next(iter(dic.values()))
    for k, v in dic.items():
        assert v[0] == ref[0] and abs(v[1] - ref[1]) <= tol, f"Resultados distintos: {dic}"
    print("OK: todas las formas dejaron el mismo resultado ->", ref)

def medir_llegadas(tag, llegadas, esquema, historial=None):
    """Corre A, B y C sobre una lista de llegadas (DataFrames). Devuelve [(n, segA, segB, segC)]."""
    carpeta, ckpt = ruta(tag, "llegadas"), ruta(tag, "ckpt")
    tA, tB, tC = fqn(f"{tag}_A"), fqn(f"{tag}_B"), fqn(f"{tag}_C")
    reiniciar((tA, tB, tC), (carpeta, ckpt))
    dbutils.fs.mkdirs(carpeta)
    if historial is not None:            # datos ya acumulados (no se cronometra)
        historial.write.mode("overwrite").parquet(f"{carpeta}/llegada_0")
        A_completo(carpeta, tA); B_streaming(carpeta, ckpt, tB, esquema); C_incremental(f"{carpeta}/llegada_0", tC)
    salida = []
    for n, df in enumerate(llegadas, 1):
        df.write.mode("overwrite").parquet(f"{carpeta}/llegada_{n}")   # llegada: no se cronometra
        a = round(A_completo(carpeta, tA), 2)
        b = round(B_streaming(carpeta, ckpt, tB, esquema), 2)
        c = round(C_incremental(f"{carpeta}/llegada_{n}", tC), 2)
        salida.append((n, a, b, c))
        print(f"  [{tag}] llegada {n}: A={a}s | B={b}s | C={c}s")
    verificar_iguales({"A": resumen_tabla(tA), "B": resumen_tabla(tB), "C": resumen_tabla(tC)})
    return salida

