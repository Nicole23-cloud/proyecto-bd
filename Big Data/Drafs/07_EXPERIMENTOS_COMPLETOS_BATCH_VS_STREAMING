def sql_merge(tabla, vista):
    sets  = ", ".join(f"t.{c}=s.{c}" for c in COLS)
    ins_c = ", ".join(COLS)
    ins_v = ", ".join(f"s.{c}" for c in COLS)
    return f"""MERGE INTO {tabla} t USING {vista} s
               ON t.order_id = s.order_id AND t.order_item_id = s.order_item_id
               WHEN MATCHED AND s.op = 'D' THEN DELETE
               WHEN MATCHED THEN UPDATE SET {sets}
               WHEN NOT MATCHED AND s.op <> 'D' THEN INSERT ({ins_c}) VALUES ({ins_v})"""

