                                       (F.col("id") + 1000).alias("ts"), F.rand(99).alias("valor"))
        d = d.unionByName(tard)
    return d

def D_marca_agua(ruta_llegada, tabla):
    t = time.time()
    df = spark.read.parquet(ruta_llegada)
    if spark.catalog.tableExists(tabla):
