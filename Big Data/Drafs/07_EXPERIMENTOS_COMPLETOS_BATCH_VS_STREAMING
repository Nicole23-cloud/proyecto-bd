                     ("B_ingenuo", "B_ingenuo"), ("B_idempotente", "B_idempotente")]:
    try:
        filas, caidas = correr_e6(nombre, tipo)
        res6[nombre] = filas - ESPERADAS6
        print(f"{nombre}: {filas:,} filas (esperadas {ESPERADAS6:,}) | caídas simuladas: {caidas} | duplicados: {filas - ESPERADAS6:,}")
    except Exception as e:
        print(f"{nombre}: no se pudo ejecutar en este entorno -> {str(e)[:150]}")
        res6[nombre] = float("nan")
    registrar("6_fallos", nombre, "filas_duplicadas", res6[nombre])

