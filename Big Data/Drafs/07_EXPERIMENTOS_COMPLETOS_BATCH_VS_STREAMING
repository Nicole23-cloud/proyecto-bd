def productor(tag, carpeta):
    """Hilo que deja caer un archivo pequeño cada LAT_CADA_SEG segundos."""
    def run():
        for i in range(1, LAT_ARCHIVOS + 1):
            stg = ruta(tag, "staging", f"llegada_{i}")
            (spark.read.parquet(SEMILLA).withColumn("ts_llegada", F.current_timestamp())
                  .write.mode("overwrite").parquet(stg))
            dbutils.fs.mv(stg, f"{carpeta}/llegada_{i}", True)   # aparece completo de golpe
            time.sleep(LAT_CADA_SEG)
    return threading.Thread(target=run)

