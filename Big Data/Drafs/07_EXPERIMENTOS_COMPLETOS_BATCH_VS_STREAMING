# MAGIC %md
# MAGIC ---
# MAGIC # EXPERIMENTO 6: Fallos y duplicados (idempotencia)
# MAGIC *Llegan 3 tandas de 1.000 filas. En la tanda 2 el proceso **se cae justo después de escribir** y se reintenta.*
# MAGIC
# MAGIC | Forma | Qué pasa al reintentar |
# MAGIC |---|---|
# MAGIC | A | Reescribe todo: sin duplicados |
# MAGIC | C ingenuo | Vuelve a agregar la tanda: **duplicados** |
# MAGIC | C idempotente | Usa `txnAppId`/`txnVersion` de Delta: el segundo intento se ignora |
# MAGIC | B ingenuo | El checkpoint no registró el lote, lo repite: **duplicados** |
# MAGIC | B idempotente | Igual que C idempotente, con el `batch_id` |
# MAGIC
# MAGIC **Esperado:** 3.000 filas finales. Cualquier cosa por encima son duplicados.

# COMMAND ----------

ESPERADAS6 = 3000

def correr_e6(nombre, tipo):
    carpeta, ckpt, tabla = ruta("e6", nombre, "llegadas"), ruta("e6", nombre, "ckpt"), fqn(f"e6_{nombre}")
    reiniciar((tabla,), (ruta("e6", nombre),))
    dbutils.fs.mkdirs(carpeta)
    app = f"e6_{nombre}_{CORRIDA}"

    def proc(n, fallar):
        if tipo == "A":
            spark.read.parquet(f"{carpeta}/llegada_*").write.mode("overwrite").saveAsTable(tabla)
        elif tipo in ("C_ingenuo", "C_idempotente"):
            w = spark.read.parquet(f"{carpeta}/llegada_{n}").write.mode("append")
            if tipo == "C_idempotente":
                w = w.option("txnAppId", app).option("txnVersion", n)
            w.saveAsTable(tabla)
        else:   # B_ingenuo / B_idempotente
            def lote(df, batch_id):
                w = df.write.mode("append")
                if tipo == "B_idempotente":
                    w = w.option("txnAppId", app).option("txnVersion", batch_id)
                w.saveAsTable(tabla)
                if fallar:
                    raise Exception("CRASH simulado después de escribir")
            q = (spark.readStream.format("cloudFiles").option("cloudFiles.format", "parquet")
                 .schema(ESQ_E).load(carpeta)
                 .writeStream.foreachBatch(lote)
                 .option("checkpointLocation", ckpt).trigger(availableNow=True).start())
            q.awaitTermination()
        if fallar and not tipo.startswith("B"):
            raise Exception("CRASH simulado después de escribir")

    caidas = 0
    for n in (1, 2, 3):
        tanda_df(n).write.mode("overwrite").parquet(f"{carpeta}/llegada_{n}")
        try:
            proc(n, fallar=(n == 2))
        except Exception:
            caidas += 1
            proc(n, fallar=False)   # reintento
    return spark.table(tabla).count(), caidas

res6 = {}
