USE OLIST_DATAMART;
GO

-- Activar tiempos y lecturas lógicas en Mensajes
SET STATISTICS TIME ON;
SET STATISTICS IO ON;
GO

-- 1. Consulta base antes de crear el índice
SELECT 
    t.anio,
    t.mes,
    ISNULL(p.categoria_ingles, 'sin_categoria') AS categoria,
    COUNT_BIG(*) AS total_items,
    SUM(f.precio) AS total_ventas,
    SUM(f.flete) AS total_fletes
FROM dbo.fact_ventas f
INNER JOIN dbo.dim_producto p ON f.id_producto = p.id_producto
INNER JOIN dbo.dim_tiempo t   ON f.id_tiempo = t.id_tiempo
GROUP BY t.anio, t.mes, ISNULL(p.categoria_ingles, 'sin_categoria')
ORDER BY t.anio, t.mes, total_ventas DESC;
GO

-- 2. Crear índice no agrupado en fact_ventas para la prueba
IF NOT EXISTS (
    SELECT 1 
    FROM sys.indexes 
    WHERE name = 'IX_fact_ventas_tiempo_producto_inc' 
      AND object_id = OBJECT_ID('dbo.fact_ventas')
)
BEGIN
    CREATE NONCLUSTERED INDEX IX_fact_ventas_tiempo_producto_inc
    ON dbo.fact_ventas (id_tiempo, id_producto)
    INCLUDE (precio, flete, cantidad_articulos);
END
GO

-- 3. Misma consulta después de crear el índice para comparar
SELECT 
    t.anio,
    t.mes,
    ISNULL(p.categoria_ingles, 'sin_categoria') AS categoria,
    COUNT_BIG(*) AS total_items,
    SUM(f.precio) AS total_ventas,
    SUM(f.flete) AS total_fletes
FROM dbo.fact_ventas f
INNER JOIN dbo.dim_producto p ON f.id_producto = p.id_producto
INNER JOIN dbo.dim_tiempo t   ON f.id_tiempo = t.id_tiempo
GROUP BY t.anio, t.mes, ISNULL(p.categoria_ingles, 'sin_categoria')
ORDER BY t.anio, t.mes, total_ventas DESC;
GO

-- Desactivar estadísticas
SET STATISTICS TIME OFF;
SET STATISTICS IO OFF;
GO
